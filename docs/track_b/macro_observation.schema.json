  "required": [
    "series_id",
    "geography",
    "reference_period",
    "release_date",
    "vintage_date",
    "revision_date",
    "value",
    "revision_sequence",
    "source",
    "frequency",
    "units",
    "seasonal_adjustment",
    "retrieved_at",
    "source_hash"
